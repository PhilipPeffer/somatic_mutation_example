# Configuration for one pipeline run. Sourced by the Codespace scripts (aws/*.sh)
# AND by the EC2 instance (pipeline/run_pipeline.sh), so it must stay plain
# `KEY=value` bash. It contains no secrets; commit it so every run is tied to a
# git commit (aws/launch.sh refuses to launch from uncommitted changes).

# ----------------------------------------------------------------------------
# AWS
# ----------------------------------------------------------------------------
AWS_REGION=us-east-1          # the SRA Open Data mirror lives in us-east-1: no transfer charges
BUCKET=CHANGE-ME-sentieon-wgs # globally unique bucket name, e.g. <yourname>-sentieon-wgs-<account-id>
PROJECT=sentieon-wgs          # prefix for IAM role, security group and launch template names

# Spot instance candidates. All have local NVMe (RAID0'd to /scratch, >=2.4 TB)
# and >=48 vCPU. The fleet picks the one with the best price/capacity.
INSTANCE_TYPES="c6id.16xlarge m6id.16xlarge r6id.16xlarge c6id.12xlarge m6id.12xlarge m5d.16xlarge c5ad.16xlarge"
SPOT_MAX_PRICE=""             # USD/hour cap; empty = never pay more than on-demand
SUBNET_IDS=""                 # space-separated; empty = all default-VPC subnets (need internet access)
ROOT_VOLUME_GB=60
MAX_RUNTIME_HOURS=36          # hard stop: the instance terminates itself after this long
KEEP_INSTANCE_ON_FAILURE=0    # 1 = leave the instance running after a failure for debugging (SSM)
PIXI_VERSION=v0.81.0          # keep in sync with .devcontainer/Dockerfile

# ----------------------------------------------------------------------------
# Sentieon
# ----------------------------------------------------------------------------
SENTIEON_VERSION=202503.04    # newest public release as of 2026-09; use the one Sentieon names for your trial
# Set ONE of the following (see docs/WALKTHROUGH.md, "Sentieon license"):
SENTIEON_LICENSE_S3=s3://${BUCKET}/license/sentieon.lic
SENTIEON_LICENSE_SERVER=""    # host:port, if Sentieon gave you a license server instead of a file
# If Sentieon's instructions include authentication variables for its cloud
# license server, uncomment and fill them in exactly as given (exported to Sentieon):
# SENTIEON_AUTH_MECH=""
# SENTIEON_AUTH_DATA=""

# ----------------------------------------------------------------------------
# Pipeline
# ----------------------------------------------------------------------------
RUN_ID=seqc2_wgs_SRR7890893_vs_SRR7890943_v1   # results go to s3://$BUCKET/runs/$RUN_ID/
SAMPLES_TSV=config/samples.tsv
GENOME=hg38                   # reference bundle pinned in config/references_hg38.tsv
CALLER=tnhaplotyper2          # tnhaplotyper2 (Mutect2-equivalent) or tnscope
TNSCOPE_MODEL_S3=""           # CALLER=tnscope only: ML model bundle from Sentieon
TNSCOPE_ARGS=""               # CALLER=tnscope only: model-specific options

# Pre-alignment QC / preprocessing (docs/WALKTHROUGH.md, step 13)
TRIM_READS=1                  # trim adapters + low-quality 3' ends with Trim Galore before alignment
TRIM_ARGS="--length 36"       # Trim Galore options (defaults: auto-detected adapter, -q 20)
RUN_FASTQC=1                  # FastQC on raw (and trimmed) reads, alongside alignment

# Annotation of the PASS calls (docs/WALKTHROUGH.md step 13)
ANNOTATE=1                    # VEP + vcf2maf -> annotated VCF and MAF
VEP_CACHE_VERSION=116         # must match the ensembl-vep major version pinned in pixi.toml [feature.annotate]
VEP_ARGS=""                   # extra VEP options, e.g. plugins

# Smoke test (`--smoke` flag on the aws/*.sh scripts / pixi tasks): same
# pipeline on a small subset of reads, RUN_ID suffixed with "_smoke", on a
# smaller instance. Checks license, IAM, S3 and every step for about $1.
SMOKE_SUBSAMPLE_READS=2000000                       # first N read pairs of each run
SMOKE_CALL_INTERVALS=chr22                          # restrict variant calling
SMOKE_INSTANCE_TYPES="c6id.4xlarge m6id.4xlarge m5d.4xlarge c5d.4xlarge"
